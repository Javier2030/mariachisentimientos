import hashlib
from datetime import date as _date
_HASHES_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "page_hashes.json")
try:
    _HASHES = json.load(open(_HASHES_FILE))
except Exception:
    _HASHES = {}

def page_lastmod(page):
    """Fecha del último cambio REAL de contenido (hash del dict de la página)."""
    raw = json.dumps({k: v for k, v in page.items()}, ensure_ascii=False, sort_keys=True, default=str)
    h = hashlib.sha256(raw.encode()).hexdigest()[:16]
    rec = _HASHES.get(page["slug"])
    if rec and rec.get("hash") == h:
        return rec["date"]
    _HASHES[page["slug"]] = {"hash": h, "date": _date.today().isoformat()}
    return _HASHES[page["slug"]]["date"]

def _save_hashes():
    json.dump(_HASHES, open(_HASHES_FILE, "w"), ensure_ascii=False, indent=1)

def _validar():
    """Gate anti-regresión: falla el build si hay duplicados o JSON-LD roto."""
    import collections
    problemas = []
    vistos = {"title": collections.defaultdict(list), "meta": collections.defaultdict(list), "h1": collections.defaultdict(list)}
    for p in PAGES:
        for campo in ("title", "meta", "h1"):
            vistos[campo][p[campo]].append(p["slug"])
        try:
            json.loads(jsonld(p))
        except Exception as e:
            problemas.append(f"JSON-LD roto en {p['slug']}: {e}")
        # 62/158: los límites REALES de Google. Antes eran 65/165 y por eso se coló
        # una description de 160 car. a producción.
        if len(p["title"]) > 62: problemas.append(f"title largo ({len(p['title'])}) en {p['slug']}")
        if len(p["meta"]) > 158: problemas.append(f"meta larga ({len(p['meta'])}) en {p['slug']}")
    for campo, d in vistos.items():
        for v, slugs in d.items():
            if len(slugs) > 1: problemas.append(f"{campo} duplicado: {slugs}")
    if problemas:
        for pr in problemas: print("⛔", pr)
        raise SystemExit("BUILD ABORTADO: corrige los problemas de arriba")

# ── Copias locales de respaldo (idénticas a sistema_diseno/serp.py) ─────────
# Existen para que el generador SIEMPRE pueda construir el sitio, aunque falte la
# biblioteca compartida. Un sitio que no se puede regenerar es un sitio caído.
def _fit_title_local(t, lim=62):
    t = re.sub(r"\s+", " ", (t or "")).strip()
    if len(t) <= lim: return t
    sin_ano = re.sub(r"\s*\((?:19|20)\d\d\)\s*$", "", t).strip()
    if len(sin_ano) <= lim: return sin_ano
    cands = []
    for sep in (" | ", " \u2014 ", " \u2013 ", " - ", ": ", " ("):
        if sep in sin_ano:
            h = sin_ano.split(sep)[0].strip()
            if 30 <= len(h) <= lim: cands.append(h)
    if cands: return max(cands, key=len)
    return sin_ano[:lim - 1].rsplit(" ", 1)[0].rstrip(" ,;:\u2014-\u00b7(") + "\u2026"

def _fit_meta_local(m, lim=158):
    m = re.sub(r"\s+", " ", (m or "")).strip()
    if len(m) <= lim: return m
    cut = m[:lim]
    i = cut.rfind(". ")
    if i > lim * 0.62: return cut[:i + 1].strip()
    for sep in ("; ", ", "):
        j = cut.rfind(sep)
        if j > lim * 0.62: return cut[:j].strip().rstrip(" ,;:\u2014-\u00b7") + "."
    return cut.rsplit(" ", 1)[0].rstrip(" ,;:\u2014-\u00b7") + "."

def _serp_fit():
    """Ajusta title y meta de TODAS las páginas antes de escribir nada.

    Se hace sobre PAGES, no sobre la plantilla, para que <title>, og:title,
    twitter:description, el feed, llms.txt y el sitemap salgan del MISMO texto: si
    sólo se recortara en el <title>, Google vería una cosa y el feed otra.
    """
    ft = _serp.fit_title if _COMPARTIDO else (lambda t: _fit_title_local(t))
    fm = _serp.fit_meta if _COMPARTIDO else _fit_meta_local
    tocadas = 0
    for p in PAGES:
        t, m = ft(p["title"]), fm(p["meta"])
        if t != p["title"] or m != p["meta"]:
            tocadas += 1
            print(f"[serp] {p['slug']}: title {len(p['title'])}\u2192{len(t)} \u00b7 meta {len(p['meta'])}\u2192{len(m)}")
            p["title"], p["meta"] = t, m
    return tocadas

